<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tv_avatar_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:background="@drawable/bg_avatar_other" />

    <LinearLayout
        android:id="@+id/ll_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="6dp">

        <TextView
            android:id="@+id/tv_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/ink_subtle"
            android:layout_marginBottom="2dp" />

        <ImageView
            android:id="@+id/iv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:minHeight="120dp"
            android:maxWidth="260dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_chapter_card"
            android:padding="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_avatar_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="我"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_avatar_me" />
</LinearLayout>
