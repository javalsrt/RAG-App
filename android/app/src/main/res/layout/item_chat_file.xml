<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tv_avatar_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:background="@drawable/bg_avatar_other" />

    <LinearLayout
        android:id="@+id/ll_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="6dp">

        <TextView
            android:id="@+id/tv_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/ink_subtle"
            android:layout_marginBottom="2dp" />

        <!-- 文件卡片：图标 + 文件名 -->
        <LinearLayout
            android:id="@+id/ll_file_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_file_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="文"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF0A84FF"
                android:background="@drawable/bg_file_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tv_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件名"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:maxWidth="180dp"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击下载"
                    android:textSize="11sp"
                    android:textColor="@color/ink_subtle"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_avatar_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="我"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_avatar_me" />
</LinearLayout>
